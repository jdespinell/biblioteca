# ─── Environment variables for Biblioteca SaaS PWA ───
# Copy this file to .env and fill in the values
#
# IMPORTANTE: Este stack corre junto a otros servicios en el servidor.
# Puertos del host asignados para evitar conflictos:
#   backend   → 8002  (8000 = finanzas_backend)
#   frontend  → 3003  (3001 = medfamilia-app)
#   postgres  → 5434  (5433 = medfamilia-postgres en 127.0.0.1)
#   minio api → 9002  (9000 = portainer)
#   minio ui  → 9003
#   nginx     → eliminado (se usa el Nginx Proxy Manager existente)

# ─────────────────────────────────────────────
# Servidor
# ─────────────────────────────────────────────
# IP o dominio de tu servidor Ubuntu (para que el navegador encuentre el backend)
# Ejemplos:
#   SERVER_IP=192.168.1.100
#   SERVER_IP=biblioteca.tudominio.com
SERVER_IP=TU_IP_O_DOMINIO_AQUI

# ─────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────
POSTGRES_USER=biblioteca
POSTGRES_PASSWORD=biblioteca_secret_change_me
POSTGRES_DB=biblioteca_db
# La URL usa el nombre del servicio Docker "postgres", no localhost ni 5434
DATABASE_URL=postgresql+asyncpg://biblioteca:biblioteca_secret_change_me@postgres:5432/biblioteca_db

# ─────────────────────────────────────────────
# JWT Auth
# ─────────────────────────────────────────────
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-me-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─────────────────────────────────────────────
# ── Google Gemini API ─────────────────────────────────────────────────────────
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Modelos recomendados: gemini-1.5-flash-latest, gemini-2.0-flash, gemini-1.5-pro-latest
GEMINI_MODEL=gemini-1.5-flash-latest

# ─────────────────────────────────────────────
# MinIO (Object Storage)
# ─────────────────────────────────────────────
# La URL interna usa el nombre del servicio Docker, no el puerto 9002 del host
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret_change_me
MINIO_BUCKET_NAME=biblioteca-files

# ─────────────────────────────────────────────
# CORS (orígenes permitidos para el backend)
# ─────────────────────────────────────────────
# Con NPM y dominio propio:
#   CORS_ORIGINS=https://biblioteca.tudominio.com
# Sin dominio (acceso por IP/puerto directamente):
#   CORS_ORIGINS=http://TU_IP:3003,http://TU_IP
CORS_ORIGINS=http://localhost:3003,http://localhost

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
ENVIRONMENT=development
RATE_LIMIT_PER_MINUTE=100

# ─────────────────────────────────────────────
# Frontend (Next.js) — visible en el navegador
# ─────────────────────────────────────────────
# Si NPM enruta /api → backend en el mismo dominio:
#   NEXT_PUBLIC_API_URL=https://biblioteca.tudominio.com/api
# Sin dominio, acceso directo al backend por puerto:
#   NEXT_PUBLIC_API_URL=http://TU_IP:8002/api
# (esta variable se sobreescribe en docker-compose.yml con SERVER_IP)
NEXT_PUBLIC_API_URL=http://TU_IP_O_DOMINIO:8002/api
